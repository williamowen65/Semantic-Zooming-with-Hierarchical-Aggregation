49000000,"link":null,"locked":false,"index":"a36"},{"id":"child-2","type":"ellipse","x":1210,"y":694,"width":110,"height":66,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3037,"version":1,"versionNonce":4037,"isDeleted":false,"boundElements":[],"updated":1786849000000,"link":null,"locked":false,"index":"a37"},{"id":"child-3","type":"ellipse","x":1330,"y":704,"width":85,"height":48,"angle":0,"strokeColor":"#5f3dc4","backgroundColor":"#e5dbff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3038,"version":1,"versionNonce":4038,"isDeleted":false,"boundElements":[],"updated":1786849000000,"link":null,"locked":false,"index":"a38"},{"id":"comment-card","type":"rectangle","x":70,"y":505,"width":825,"height":305,"angle":0,"strokeColor":"#f59f00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":3039,"version":1,"versionNonce":4039,"isDeleted":false,"boundElements":[],"updated":1786849000000,"link":null,"locked":false,"index":"a39"},{"id":"commentary","type":"text","x":95,"y":530,"width":765,"height":250,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3040,"version":1,"versionNonce":4040,"isDeleted":false,"boundElements":[],"updated":1786849000000,"link":null,"locked":false,"index":"a40","fontSize":17,"fontFamily":2,"text":"WHY THIS HYBRID FITS ATLAS\n\n• The visible graph boundary shows one observed hierarchy layer at a time.\n• Like a packed-bubble chart, sibling regions share a bounded space and relative area can communicate qualities such as support, activity, priority, or importance.\n• Like a tree, every region still has a parent and may have children. Selecting a region drills into that branch and makes its children the next observed layer.\n• The layered approach makes this one continuous graph rather than separate diagrams.\n• The depth counter identifies the observed layer; the breadcrumb identifies the current branch and provides navigation.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WHY THIS HYBRID FITS ATLAS\n\n• The visible graph boundary shows one observed hierarchy layer at a time.\n• Like a packed-bubble chart, sibling regions share a bounded space and relative area can communicate qualities such as support, activity, priority, or importance.\n• Like a tree, every region still has a parent and may have children. Selecting a region drills into that branch and makes its children the next observed layer.\n• The layered approach makes this one continuous graph rather than separate diagrams.\n• The depth counter identifies the observed layer; the breadcrumb identifies the current branch and provides navigation.","autoResize":true,"lineHeight":1.25}],"appState":{"gridSize":20,"gridStep":5,"gridModeEnabled":false,"viewBackgroundColor":"#ffffff"},"files":{}}