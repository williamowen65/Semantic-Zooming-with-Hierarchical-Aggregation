    {"id":"semantics","type":"text","x":75,"y":1610,"width":820,"height":95,"angle":0,"strokeColor":"#5f6368","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":436,"version":1,"versionNonce":436,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Product rule: Feed view does not create a second data model. Every feed card represents an ordinary Node. A user can move horizontally between representations by opening that Node's graphical children, or move vertically into detail by opening the Node page. The same child-type structure remains underneath both paths.","fontSize":16,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Product rule: Feed view does not create a second data model. Every feed card represents an ordinary Node. A user can move horizontally between representations by opening that Node's graphical children, or move vertically into detail by opening the Node page. The same child-type structure remains underneath both paths.","lineHeight":1.25,"baseline":89,"index":"bS","autoResize":true}
