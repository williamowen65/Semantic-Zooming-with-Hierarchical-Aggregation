    {"id":"feednote","type":"text","x":60,"y":220,"width":840,"height":50,"angle":0,"strokeColor":"#5f6368","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":407,"version":1,"versionNonce":407,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The same layer shown as weighted tiles in Graph view is shown here as ranked cards. Each card exposes two deliberate actions: inspect its children graphically, or open the full Node page.","fontSize":17,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"The same layer shown as weighted tiles in Graph view is shown here as ranked cards. Each card exposes two deliberate actions: inspect its children graphically, or open the full Node page.","lineHeight":1.25,"baseline":42,"index":"b6","autoResize":true},

